generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id         String   @id @default(cuid())
  name       String
  path       String
  gitRepo    String
  branch     String   @default("main")
  framework  String
  port       Int?
  domain     String?
  pm2Process String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deployments Deployment[]
}

model Deployment {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status     String
  message    String?
  error      String?
  stdout     String?
  stderr     String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}
